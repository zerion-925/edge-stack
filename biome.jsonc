{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core", "ultracite/biome/react"],
  "files": {
    "includes": [
      "!**/dist",
      "!**/coverage",
      "!**/node_modules",
      "!apps/web/src/routeTree.gen.ts",
      "!**/worker-configuration.d.ts",
      "!playwright-report",
      "!test-results"
    ]
  },
  "overrides": [
    {
      "includes": ["apps/web/src/routes/**/*.tsx"],
      "linter": { "rules": { "performance": { "noJsxPropsBind": "off" } } }
    },
    {
      "includes": ["workers/api/src/index.ts"],
      "linter": { "rules": { "performance": { "noBarrelFile": "off" } } }
    },
    {
      "includes": ["packages/ui/src/styles/globals.css"],
      "linter": { "rules": { "style": { "noDescendingSpecificity": "off" } } }
    },
    {
      "includes": [
        "packages/ui/src/components/**/*.tsx",
        "packages/ui/src/hooks/**/*.ts"
      ],
      "linter": {
        "rules": {
          "a11y": {
            "noNoninteractiveElementInteractions": "off",
            "useAriaPropsForRole": "off",
            "useFocusableInteractive": "off",
            "useKeyWithClickEvents": "off",
            "useSemanticElements": "off"
          },
          "complexity": { "noExcessiveCognitiveComplexity": "off" },
          "correctness": {
            "noNestedComponentDefinitions": "off",
            "useExhaustiveDependencies": "off"
          },
          "performance": {
            "noJsxPropsBind": "off",
            "noNamespaceImport": "off"
          },
          "security": { "noDangerouslySetInnerHtml": "off" },
          "style": {
            "noExportedImports": "off",
            "noNestedTernary": "off",
            "useConsistentTypeDefinitions": "off",
            "useDestructuring": "off"
          },
          "suspicious": {
            "noArrayIndexKey": "off",
            "noDocumentCookie": "off",
            "noLeakedRender": "off",
            "noShadow": "off",
            "noUnnecessaryConditions": "off"
          }
        }
      }
    }
  ]
}
